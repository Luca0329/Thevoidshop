.env
.env.local
.env.development
.env.production
.env.*.local

# Build output
dist/
frontend/dist/
frontend/build/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# TheVoidShop sensitive files
config/credentials.json
secrets/
*.pem
*.key
webhook-secrets.txt

# Test coverage
coverage/
.nyc_output/

# Cache
.npm
.cache/

# Session store
sessions/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Runtime data
pids
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage/

# Shopify credentials (never commit these!)
shopify.app.toml
.shopify/

# TypeScript build outputs
dist/
*.tsbuildinfo

# React frontend files that don't belong in backend
src/pages/
src/components/
src/context/
src/data/
src/*.tsx
src/*.css
src/App.*
src/main.*
src/vite-env.d.ts
src/types/index.ts

# Absolutely exclude these React files
**/pages/**
**/components/**  
**/context/**
**/*.tsx
**/*.css
**/App.*
**/main.*
**/vite-env.d.ts
