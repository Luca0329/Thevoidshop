{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/app.ts",
    "src/services/**/*.ts",
    "src/routes/**/*.ts",
    "src/middleware/**/*.ts",
    "src/controllers/**/*.ts",
    "src/types/**/*.ts",
    "config/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "frontend/**/*",
    "**/*.tsx",
    "**/*.css",
    "**/pages/**/*",
    "**/components/**/*",
    "**/context/**/*",
    "**/data/**/*",
    "src/App.*",
    "src/main.*",
    "src/index.*",
    "src/vite-env.d.ts"
  ]
}
