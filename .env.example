# =================================================================
# TheVoidShop - Shopify Integration Environment Configuration
# =================================================================
# 
# SECURITY WARNING: Never commit the actual .env file to git!
# This is a template - copy to .env and fill with real values
#

# Shopify App Configuration
# Get these from your Shopify Partner Dashboard > Apps > Your App
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Shopify Permissions (comma-separated, no spaces)
# Required scopes for TheVoidShop operations
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory

# Application Host Configuration
# Use your actual domain in production (must match Partner Dashboard settings)
SHOPIFY_HOST_NAME=localhost:3000
SHOPIFY_CALLBACK_URL=/auth/callback

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
# Generate a strong random string for JWT (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_very_long_random_jwt_secret_key_here_minimum_64_characters

# TheVoidShop Specific Settings
VOID_SHOP_WEBHOOK_SECRET=your_webhook_verification_secret
VOID_SHOP_RATE_LIMIT=100
VOID_SHOP_MYSTIC_MODE=true

# =================================================================
# PRODUCTION NOTES:
# - Change NODE_ENV to 'production'
# - Use HTTPS for SHOPIFY_HOST_NAME
# - Generate new, secure secrets
# - Enable webhook verification
# =================================================================
