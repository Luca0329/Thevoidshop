{
  "name": "thevoidshop-shopify-integration",
  "version": "1.0.0",
  "description": "Mystical commerce integration with Shopify for TheVoidShop",
  "main": "dist/src/app.js",
  "scripts": {
    "start": "node dist/src/app.js",
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "postbuild": "echo 'Build completed successfully'",
    "build:frontend": "cd frontend && npm run build",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:install": "cd frontend && npm install"
  },
  "keywords": ["shopify", "ecommerce", "mystical", "thevoidshop", "api"],
  "author": "Lucas - TheVoidShop",
  "license": "MIT",
  "dependencies": {
    "@shopify/shopify-api": "^7.7.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "express-session": "^1.17.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.14",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.5.0",
    "@types/express-session": "^1.17.7",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "@types/jest": "^29.5.4",
    "jest": "^29.6.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0"
  }
}
